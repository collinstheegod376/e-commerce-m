generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id        String   @id @db.Uuid // = auth.users.id
  email     String   @unique
  name      String?
  phone     String?
  role      String   @default("customer") // "customer" | "admin"
  address   Json?
  createdAt DateTime @default(now()) @map("created_at")
  orders    Order[]
  cart      Cart?

  @@index([role])
  @@index([createdAt])
  @@map("profiles")
}

model Product {
  id          String           @id @default(uuid())
  slug        String           @unique
  name        String
  description String?
  priceKobo   Int              @map("price_kobo")
  active      Boolean          @default(true)
  images      String[]
  createdAt   DateTime         @default(now()) @map("created_at")
  variants    ProductVariant[]

  @@index([active])
  @@index([createdAt])
  @@map("products")
}

model ProductVariant {
  id         String      @id @default(uuid())
  productId  String      @map("product_id")
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String
  sku        String?     @unique
  stockQty   Int?        @map("stock_qty") // null = untracked
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size])
  @@index([productId])
  @@index([stockQty])
  @@map("product_variants")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique @map("user_id") @db.Uuid
  user      Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String         @map("cart_id")
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id              String         @id @default(uuid())
  reference       String         @unique
  userId          String         @map("user_id") @db.Uuid
  user            Profile        @relation(fields: [userId], references: [id])
  status          String         @default("pending") // pending|paid|failed|abandoned|fulfilled|cancelled|refunded
  subtotalKobo    Int            @map("subtotal_kobo")
  shippingKobo    Int            @default(0) @map("shipping_kobo")
  totalKobo       Int            @map("total_kobo")
  customerEmail   String         @map("customer_email")
  customerPhone   String?        @map("customer_phone")
  shippingAddress Json?          @map("shipping_address")
  paystackRef     String?        @map("paystack_ref")
  paidAt          DateTime?      @map("paid_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  items           OrderItem[]
  events          PaymentEvent[]

  @@index([status, paidAt])
  @@index([userId])
  @@index([createdAt])
  @@index([customerEmail])
  @@map("orders")
}

model OrderItem {
  id              String         @id @default(uuid())
  orderId         String         @map("order_id")
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String         @map("variant_id")
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  productNameSnap String         @map("product_name_snap")
  sizeSnap        String         @map("size_snap")
  unitPriceKobo   Int            @map("unit_price_kobo")
  qty             Int

  @@index([orderId])
  @@index([variantId])
  @@index([sizeSnap])
  @@map("order_items")
}

model PaymentEvent {
  id              String   @id @default(uuid())
  paystackEventId String   @unique @map("paystack_event_id")
  orderId         String?  @map("order_id")
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type            String
  payload         Json
  receivedAt      DateTime @default(now()) @map("received_at")

  @@index([orderId])
  @@index([receivedAt])
  @@map("payment_events")
}

model Page {
  slug      String   @id // "story", "contact"
  title     String
  content   String   // markdown
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pages")
}
