# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Database (Supabase Postgres)
# Pooler connection (port 6543, transaction mode, pgbouncer=true) used at runtime
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used ONLY by Prisma migrations
DIRECT_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"

# Paystack (Agent 4)
PAYSTACK_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_replace_me"

# Telegram Bot Notifications (Agent 5)
TELEGRAM_BOT_TOKEN="123456:replace-me"
TELEGRAM_CHAT_ID="123456789"

# Resend Email Receipts (Agent 5)
RESEND_API_KEY="re_replace_me"
RESEND_FROM="orders@maisonkriss.com"

# Support Contacts (shown on /contact, payment failures, receipts, and /admin/settings)
SUPPORT_EMAIL="support@maisonkriss.com"
SUPPORT_PHONE="+2348000000000"
SUPPORT_WHATSAPP="+2348000000000"

# Site & Admin Bootstrap
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ADMIN_EMAILS="admin@maisonkriss.com"

# Shipping (optional flat rate in kobo; 0 = complimentary)
FLAT_SHIPPING_KOBO="0"

# Optional Rate Limiting (Upstash Redis / Vercel KV; falls back to best-effort in-memory map)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
